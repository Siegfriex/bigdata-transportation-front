{
  "name": "mbn-guide-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "smoke": "node scripts/m1-smoke.mjs",
    "test:release": "tsx scripts/release-validator-smoke.ts",
    "test:regression": "tsx scripts/regression-smoke.ts",
    "test:parity": "tsx scripts/data-line-smoke.ts",
    "test:m14-compat": "tsx scripts/m14-compatibility-smoke.ts",
    "test:fsd": "tsx scripts/fsd-boundary-smoke.ts",
    "test:design-system": "tsx scripts/design-system-smoke.ts",
    "test": "npm run test:design-system && npm run test:fsd && npm run test:regression && npm run test:release && npm run test:parity",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_MODE=production RUN_PROVIDER_CANARY=1 playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
