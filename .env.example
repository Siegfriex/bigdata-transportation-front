# GEMINI_API_KEY: Required for live Gemini AI API calls.
# Local dev: copy this file to .env or .env.local and set a real key.
# Vercel: configure this in Project Settings -> Environment Variables.
# If this is missing or left as MY_GEMINI_API_KEY, /api/chat returns deterministic fallback data.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Defaults to gemini-2.5-flash in the server responder.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Optional public URL where this app is hosted.
# Vercel automatically provides VERCEL_URL; set APP_URL only when code needs a stable canonical URL.
APP_URL="MY_APP_URL"

# Browser-only Google Maps key for Maps JavaScript API rendering.
# This key is public in the Vite bundle; restrict it by API and website referrer.
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Google Maps Map ID for cloud styling and advanced marker support.
VITE_GOOGLE_MAPS_MAP_ID=""
