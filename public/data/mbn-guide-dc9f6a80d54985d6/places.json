로 보인다."}},"offerIds":[],"placeId":"place_0020","provenance":{"coordinateSource":"TOUR_API","generationMethod":"EXTRACTIVE_MBN_EVIDENCE","identitySource":"TOUR_API","projectionCategoryMethod":"RULE_EXACT","sourceArticleIds":["5190167"]},"slug":"place-6f0581b3cd","status":"ACTIVE","tags":[]},{"availableLocales":["ko"],"canonicalName":"오천그린광장","category":"healing","coordinates":{"lat":34.933198,"lng":127.497971},"heroImageUrl":null,"linkedCommunityThreadIds":[],"linkedLiveSessionIds":[],"linkedStoryIds":[],"localeContent":{"ko":{"title":"오천그린광장","whyItMatters":"\"설마(馬), 이래도 안올쿠?\" 오천그린광장"}},"offerIds":[],"placeId":"place_0021","provenance":{"coordinateSource":"TOUR_API","generationMethod":"EXTRACTIVE_MBN_EVIDENCE","identitySource":"TOUR_API","projectionCategoryMethod":"RULE_EXACT","sourceArticleIds":["5175566"]},"slug":"place-fd5fff1ec9","status":"ACTIVE","tags":[]},{"availableLocales":["ko"],"canonicalName":"국립등대박물관","category":"exhibition","coordinates":{"lat":36.077794310696,"lng":129.568227911497},"heroImageUrl":null,"linkedCommunityThreadIds":[],"linkedLiveSessionIds":[],"linkedStoryIds":[],"localeContent":{"ko":{"title":"국립등대박물관","whyItMatters":"전국 미식가들이 손꼽아 기다리는 ‘영덕대게축제’도 3월 26일부터 29일까지 인근 강구항 해파랑공원에서 열린다. 이달의 등대에 대한 자세한 내용은 국립등대박물관 ‘등대와 바다’ 홈페이지에서 확인할 수 있다."}},"offerIds":[],"placeId":"place_0024","provenance":{"coordinateSource":"TOUR_API","generationMethod":"EXTRACTIVE_MBN_EVIDENCE","identitySource":"TOUR_API","projectionCategoryMethod":"RULE_EXACT","sourceArticleIds":["5181536"]},"slug":"place-cc860d30c5","status":"ACTIVE","tags":[]},{"availableLocales":["ko"],"canonicalName":"빙하미술관","category":"exhibition","coordinates":{"lat":37.3936915606,"lng":127.7891320059},"heroImageUrl":null,"linkedCommunityThreadIds":[],"linkedLiveSessionIds":[],"linkedStoryIds":[],"localeContent":{"ko":{"title":"빙하미술관","whyItMatters":"원주시는 2월 1~28일까지 순환형 시티투어 이용료를 20% 할인(성인 1일권 기준 4,000원)하며, 시티투어 탑승객을 대상으로 ‘뮤지엄 산’과 ‘빙하미술관’ 20% 할인 혜택을 제공한다."}},"offerIds":[],"placeId":"place_0025","pr